---
import { navGroups } from '../data/site-content.js';

const { current = '' } = Astro.props;
---

<nav class="wiki-nav-panel" aria-label="Guide map">
  <strong>Guide Map</strong>
  <div class="wiki-nav-list">
    {navGroups.map((group) => (
      <a class={current === group.slug ? 'active' : ''} href={group.slug}>
        <span>{group.title}</span>
        <em>{group.items.length}</em>
      </a>
    ))}
  </div>
</nav>
