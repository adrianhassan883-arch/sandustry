---
const { table } = Astro.props;
---

{table && (
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          {table.columns.map((column) => <th>{column}</th>)}
        </tr>
      </thead>
      <tbody>
        {table.rows.map((row) => (
          <tr>
            {row.map((cell) => <td>{cell}</td>)}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
)}
